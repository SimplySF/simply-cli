{
  "name": "@simplysf/simply-mcp-clients",
  "description": "Installs an MCP server entry into MCP clients (Claude Code, Claude Desktop, Cursor, VS Code, Windsurf, Gemini CLI, Codex CLI) without disturbing the rest of their configuration",
  "version": "0.1.0",
  "author": "@ClayChipps",
  "homepage": "https://github.com/SimplySF/simply-cli",
  "bugs": "https://github.com/SimplySF/simply-cli/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/SimplySF/simply-cli",
    "directory": "packages/simply-mcp-clients"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "/lib"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "cursor",
    "vscode",
    "gemini",
    "codex",
    "simply"
  ],
  "license": "Apache-2.0",
  "exports": "./lib/index.js",
  "type": "module",
  "types": "./lib/index.d.ts",
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@vitest/coverage-v8": "^4.1.10",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "wireit",
    "compile": "wireit",
    "fix-license": "eslint src test --fix --rule \"header/header: [2]\"",
    "format": "wireit",
    "lint": "wireit",
    "test": "wireit",
    "test:only": "wireit",
    "test:watch": "vitest watch --project simply-mcp-clients"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "compile",
        "lint"
      ]
    },
    "compile": {
      "command": "tsc -p . --pretty --incremental",
      "files": [
        "src/**/*.ts",
        "**/tsconfig.json",
        "../../tsconfig.json"
      ],
      "output": [
        "lib/**",
        "*.tsbuildinfo"
      ],
      "clean": "if-file-deleted"
    },
    "format": {
      "command": "prettier --write \"+(src|test)/**/*.+(ts|js|json)\"",
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        ".prettier*"
      ],
      "output": []
    },
    "lint": {
      "command": "eslint src test --color --cache --cache-location .eslintcache",
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "**/.eslint*",
        "**/tsconfig.json",
        "../../eslint.config.mjs",
        "../../tsconfig.json"
      ],
      "output": []
    },
    "test": {
      "dependencies": [
        "test:compile",
        "test:only",
        "lint"
      ]
    },
    "test:compile": {
      "command": "tsc -p \"./test\" --pretty",
      "files": [
        "test/**/*.ts",
        "**/tsconfig.json",
        "../../tsconfig.json"
      ],
      "output": []
    },
    "test:only": {
      "command": "vitest run --project simply-mcp-clients",
      "env": {
        "FORCE_COLOR": "2"
      },
      "files": [
        "test/**/*.ts",
        "src/**/*.ts",
        "**/tsconfig.json",
        "../../tsconfig.json",
        "vitest.config.ts"
      ],
      "output": []
    }
  }
}
